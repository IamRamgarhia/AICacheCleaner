{
  "name": "ai-clutter-cleaner",
  "private": true,
  "version": "1.0.0",
  "description": "AI Clutter Cleaner — 100% Safe On-Demand AI Disk & Cache Optimizer",
  "author": "Dice Codes (https://dicecodes.com/)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "tsx server/index.ts",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:server": "npx esbuild server/index.ts --bundle --platform=node --target=node18 --outfile=dist/server.cjs --format=cjs",
    "build": "vite build && npm run build:server",
    "build:win-installer": "npm run build && npx electron-builder --win nsis",
    "build:win-portable": "npm run build && npx electron-builder --win portable",
    "build:mac-dmg": "npm run build && npx electron-builder --mac dmg",
    "build:mac-portable": "npm run build && npx electron-builder --mac zip",
    "build:all": "npm run build && npx electron-builder --win nsis portable --mac dmg zip",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "pidusage": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "trash": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "34.0.0",
    "electron-builder": "25.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.dicecodes.aicluttercleaner",
    "productName": "AI-Clutter-Cleaner",
    "electronVersion": "34.0.0",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "portable": {
      "artifactName": "AI-Clutter-Cleaner-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "AI-Clutter-Cleaner-Setup-${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "artifactName": "AI-Clutter-Cleaner-macOS-${version}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ]
    }
  }
}
