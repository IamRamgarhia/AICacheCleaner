{
  "name": "ai-cache-cleaner",
  "private": true,
  "version": "1.0.0",
  "description": "AICacheCleaner — 100% Safe On-Demand AI Disk, Memory & Cache Optimizer",
  "author": "Dice Codes (https://dicecodes.com/)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "tsx server/index.ts",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:server": "npx esbuild server/index.ts --bundle --platform=node --target=node18 --outfile=dist/server.cjs --format=cjs",
    "build": "vite build && npm run build:server",
    "build:win-installer": "npm run build && npx electron-builder --win nsis",
    "build:win-portable": "npm run build && npx electron-builder --win portable",
    "build:mac-dmg": "npm run build && npx electron-builder --mac dmg",
    "build:mac-portable": "npm run build && npx electron-builder --mac zip",
    "build:all": "npm run build && npx electron-builder --win nsis portable --mac dmg zip",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck": "npm run typecheck:app && npm run typecheck:server",
    "lint": "eslint .",
    "prebuild": "npm run typecheck",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "pidusage": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "trash": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "34.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
