{
  "appId": "org.aihygiene.desktop",
  "productName": "AI-Hygiene",
  "copyright": "Copyright © 2026 AI-Hygiene FOSS Community",
  "directories": {
    "output": "dist-desktop"
  },
  "files": [
    "dist/**/*",
    "server/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AI-Hygiene",
    "uninstallDisplayName": "AI-Hygiene (Uninstall)",
    "runAfterFinish": true
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.utilities"
  }
}
